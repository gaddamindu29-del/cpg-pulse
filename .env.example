# Copy this file to `.env` and adjust as needed. `.env` is git-ignored -- never
# commit real credentials. All values below are safe local-dev defaults.

# --- Environment selector ---
# "local" -> MinIO + Postgres-as-warehouse. "cloud" -> real S3 + Snowflake.
# See docs/architecture.md section 7 (Local vs. Cloud Deployment).
CPG_PULSE_ENV=local

# --- Object storage (MinIO locally / S3 in cloud) ---
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=cpgpulse
AWS_SECRET_ACCESS_KEY=cpgpulse_dev_secret
AWS_REGION=us-east-1
S3_BUCKET_RAW=cpg-pulse-raw
S3_BUCKET_STANDARDIZED=cpg-pulse-standardized
S3_BUCKET_CURATED=cpg-pulse-curated
S3_BUCKET_QUARANTINE=cpg-pulse-quarantine

# --- Pipeline metadata store (always PostgreSQL, local and cloud) ---
METADATA_DB_HOST=localhost
METADATA_DB_PORT=5432
METADATA_DB_NAME=cpg_pulse_metadata
METADATA_DB_USER=cpgpulse
METADATA_DB_PASSWORD=cpgpulse_dev_password

# --- Warehouse ---
# WAREHOUSE_TYPE=postgres -> local dbt target. WAREHOUSE_TYPE=snowflake -> cloud.
WAREHOUSE_TYPE=postgres
WAREHOUSE_DB_HOST=localhost
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=cpg_pulse_warehouse
WAREHOUSE_DB_USER=cpgpulse
WAREHOUSE_DB_PASSWORD=cpgpulse_dev_password

# Only used when WAREHOUSE_TYPE=snowflake (not required for local dev)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=CPG_PULSE_ROLE
SNOWFLAKE_WAREHOUSE=CPG_PULSE_WH
SNOWFLAKE_DATABASE=CPG_PULSE
SNOWFLAKE_SCHEMA=MARTS

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=cpgpulse_dev_airflow_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Dashboard ---
DASHBOARD_API_BASE_URL=http://localhost:8000
